<Window x:Class="DanoniEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanoniEditor.App"
        Title="ダンおに譜面エディタ" Width="1280" Height="800"
        Icon="Assets/AppIcon.ico">
    <!-- 仕様書6.1: 上段=グローバル設定 / 左=編集ツール / 中央=譜面 / 右=プロパティ / 下=ステータス -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規プロジェクト(_N)" Click="NewProject_Click"/>
                <MenuItem Header="開く(_O)..." Click="OpenProject_Click"/>
                <!-- 2026-07-26: 最近開いたファイル(ITTNエディタ形式)。項目はSubmenuOpened時に動的構築。
                     ダミー子項目は「▶」矢印を出すためのプレースホルダ(空だとWPFが子持ちメニューと認識せず開かない)。 -->
                <MenuItem x:Name="RecentFilesMenu" Header="最近開いたファイル(_R)" SubmenuOpened="RecentFilesMenu_SubmenuOpened">
                    <MenuItem Header="(履歴なし)"/>
                </MenuItem>
                <MenuItem Header="上書き保存(_S)" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <!-- 2026-07-26要望対応: 上書き保存と処理は同じで、保存先を毎回選び直す -->
                <MenuItem Header="名前を付けて保存(_A)..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="dos.txtをエクスポート(_E)..." InputGestureText="Ctrl+E" Click="ExportDos_Click"/>
                <!-- 2026-07-23: 合作用途(TBD 5)。カレント難易度タブ1つだけをITTNエディタ形式で書き出す -->
                <MenuItem Header="現在の難易度タブをエクスポート(_T)..." Click="ExportCurrentTab_Click"/>
                <!-- 2026-08-03要望対応: 現在の難易度タブ1つを他エディタ形式へ書き出す -->
                <MenuItem Header="SKBエディタへエクスポート..." Click="ExportSkb_Click"/>
                <MenuItem Header="FUJIエディタへエクスポート..." Click="ExportFuji_Click"/>
                <Separator/>
                <!-- 2026-07-30要望対応: FUJI D&D・SKBコピペをまとめた専用ウィンドウ(繰り返しインポートしたい時の近道) -->
                <MenuItem Header="インポートウィンドウ(_I)..." Click="OpenImportHubWindow_Click"/>
                <MenuItem Header="FUJIエディタからのインポート..." Click="ImportFuji_Click"/>
                <MenuItem Header="SKBエディタからのインポート..." Click="ImportSkb_Click"/>
                <MenuItem Header="dos.txtからのインポート..." Click="ImportDos_Click"/>
                <MenuItem Header="ITTNエディタのタブファイルをインポート..." Click="ImportTabExport_Click"/>
                <Separator/>
                <MenuItem Header="音楽ファイルを読み込む(_M)..." Click="LoadAudio_Click"/>
                <Separator/>
                <!-- 2026-07-17: 1ウィンドウ1曲構成のため、複数曲を並行編集したい場合は
                     新しいウィンドウ(プロセス)を起動する導線が必要との要望対応。 -->
                <MenuItem Header="新しいウィンドウ(_W)" Click="NewWindow_Click"/>
            </MenuItem>
            <!-- 2026-07-19: 設定メニュー(環境設定ウィンドウ、仕様書14章) -->
            <MenuItem Header="設定(_S)">
                <MenuItem Header="環境設定(_P)..." Click="OpenPreferences_Click"/>
                <!-- 2026-07-23: 歌詞表示レーンの管理(TBD 4、word_data) -->
                <MenuItem Header="歌詞レーンの管理(_W)..." Click="OpenWordLaneManager_Click"/>
                <Separator/>
                <!-- 2026-07-26: バグ報告時にデバッグの情報源として使える環境情報を1ファイルへ書き出す要望対応 -->
                <MenuItem Header="環境報告作成(_R)..." Click="CreateDiagnosticsReport_Click"/>
                <!-- 2026-07-31: バージョン情報ダイアログ -->
                <MenuItem Header="バージョン情報(_V)..." Click="OpenAbout_Click"/>
            </MenuItem>
        </Menu>
        <!-- 2026-08-02要望対応: FHD(1920x1080)環境だと上パネルが画面幅に見切れるとの指摘対応で
             「ピッチで指定...」より後ろの項目を2段目へ折り返した。行数が増えるため高さは固定値を
             やめてコンテンツに合わせて自動算出させる(Height指定を撤去)。 -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0">
            <StackPanel VerticalAlignment="Center" Margin="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProjectTitleText" Text="(プロジェクト未作成)" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
                    <TextBlock Text="スナップ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <CheckBox x:Name="SnapEnabledCheck" Content="ON" VerticalAlignment="Center" Margin="0,0,8,0"
                              IsChecked="True" Checked="SnapToggle_Changed" Unchecked="SnapToggle_Changed"/>
                    <ComboBox x:Name="SnapDivisionCombo" Width="70" VerticalAlignment="Center"
                              SelectionChanged="SnapDivision_Changed"/>
                    <!-- 2026-07-17i: 拍情報モード/フレーム情報モード切替(仕様書7.6)。切替はUndo対象外 -->
                    <ToggleButton x:Name="FrameEditToggle" Content="フレーム情報モード" Width="120" Margin="12,0,0,0"
                                  Checked="FrameEditToggle_Changed" Unchecked="FrameEditToggle_Changed"
                                  ToolTip="ON: 全オブジェクトの絶対フレームを固定し、BPMだけを動かして当て込む(dos.txtインポート後の作業用)"/>
                    <!-- 2026-07-18: 波形表示+StartNumber編集モード(要望メモ07-15項目7・8) -->
                    <ToggleButton x:Name="WaveformToggle" Content="波形" Width="50" Margin="8,0,0,0"
                                  Checked="WaveformToggle_Changed" Unchecked="WaveformToggle_Changed"
                                  ToolTip="音声波形を譜面ビュー背景に表示(音楽読込が必要。ogg未対応)"/>
                    <ToggleButton x:Name="StartNumberEditToggle" Content="StartNumber編集" Width="110" Margin="4,0,0,0"
                                  Checked="StartNumberEditToggle_Changed" Unchecked="StartNumberEditToggle_Changed"
                                  ToolTip="ON: ドラッグで譜面全体を波形に対してスライドしStartNumberを調整。クリック=ガイド線設置。通常編集は無効"/>
                    <TextBlock Text="カーソル:" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBlock x:Name="CursorPosText" Text="-" VerticalAlignment="Center"/>
                    <TextBlock Text="開始F:" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBlock x:Name="StartFramePosText" Text="-" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="AudioFileText" Text="音楽未読込" VerticalAlignment="Center" Margin="0,0,12,0" FontStyle="Italic"/>
                    <!-- 2026-07-17g: 音楽操作ボタン(再生/一時停止/停止)は撤去。音楽再生はテスト専用のため
                         Space(目視テスト開始/終了)・Ctrl+Space(現在位置で終了)のキー操作に一本化する。 -->
                    <TextBlock Text="[Space]目視テスト" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Gray"/>
                    <TextBlock x:Name="AudioTimeText" Text="-" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!-- ノート音(既定OFF)。ONの間、目視テスト・プレイテストでノートが存在する
                         frameを通過するたびに、環境設定「テスト再生 > 全般」で選択した./sounds内の
                         音声ファイルを鳴らす -->
                    <CheckBox x:Name="HandClapCheck" Content="ノート音" VerticalAlignment="Center" Margin="0,0,4,0"
                              Checked="HandClap_Changed" Unchecked="HandClap_Changed"
                              ToolTip="ONの間、目視テスト・プレイテストでノートが存在するframeを通過するたびに、環境設定「テスト再生 &gt; 全般」で選択した音を鳴らす"/>
                    <!-- ノート音の音量調整 -->
                    <TextBox x:Name="HandClapVolumeBox" Width="36" VerticalAlignment="Center" Margin="0,0,2,0"
                             LostFocus="HandClap_Changed"/>
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!-- 2026-07-26: 音量設定(スライダー+数値入力欄、相互同期)。値はAppSettingsに永続化 -->
                    <TextBlock Text="音量:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center"
                            Margin="0,0,4,0" ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBox x:Name="VolumeBox" Width="36" VerticalAlignment="Center" Margin="0,0,2,0"
                             LostFocus="VolumeBox_LostFocus"/>
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!-- 2026-07-17g: プレイテスト(Ctrl+P)用設定。値はAppSettingsに永続化 -->
                    <TextBlock Text="プレーテスト:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <CheckBox x:Name="PlaytestReverseCheck" Content="Reverse" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="PlaytestSetting_Changed" Unchecked="PlaytestSetting_Changed"/>
                    <!-- 2026-07-20: オートプレイON/OFF。ONで全ノート±0Fジャスト自動判定 -->
                    <CheckBox x:Name="PlaytestAutoPlayCheck" Content="AutoPlay" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="PlaytestSetting_Changed" Unchecked="PlaytestSetting_Changed"/>
                    <TextBlock Text="HS:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox x:Name="PlaytestHiSpeedCombo" Width="60" VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectionChanged="PlaytestSetting_Changed"/>
                    <TextBlock Text="調整F:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBox x:Name="PlaytestOffsetBox" Width="40" VerticalAlignment="Center" Margin="0,0,4,0"
                             LostFocus="PlaytestOffset_LostFocus"/>
                    <TextBlock Text="倍率:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox x:Name="PlaytestScaleCombo" Width="60" VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectionChanged="PlaytestSetting_Changed"/>
                    <TextBlock Text="[Ctrl+P]開始" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,8,0"/>
                    <!-- 2026-07-23: 再生速度(目視テスト・プレイテスト共通、0.1〜2.0・0.1刻み) -->
                    <TextBlock Text="再生速度:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox x:Name="PlaybackSpeedCombo" Width="60" VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectionChanged="PlaybackSpeedCombo_Changed"/>
                    <!-- 2026-07-26: 再生速度をピッチ(半音移動量)から指定するダイアログを開く -->
                    <Button Content="ピッチで指定..." Width="90" VerticalAlignment="Center" Margin="0,0,8,0"
                            Click="PlaybackSpeedByPitch_Click"/>
                </StackPanel>
                <!-- 2026-08-02要望対応: FHD環境での見切れ対策で、「ピッチで指定...」より後ろの
                     表示系トグル群をここで2段目へ折り返した(元は1つ上の行に全て収まっていた)。 -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ToggleButton x:Name="ShowNoteImagesToggle" Content="ノート画像 表示" Width="100" Margin="0,0,4,0"
                                  IsChecked="True" Checked="ShowNoteImagesToggle_Changed" Unchecked="ShowNoteImagesToggle_Changed"/>
                    <!-- 2026-07-16j: ノート画像と強調表示を独立にON/OFFできるようにする要望対応。
                         IsCheckedはXAMLで固定値を書かず(起動時クラッシュ回避のため)、コード側で設定する。 -->
                    <ToggleButton x:Name="ShowHighlightGridToggle" Content="強調表示" Width="80" Margin="0,0,4,0"
                                  Checked="ShowHighlightGridToggle_Changed" Unchecked="ShowHighlightGridToggle_Changed"/>
                    <!-- 2026-07-26: レーンラベル欄へのノート数リアルタイム表示(要望対応、既定OFF) -->
                    <ToggleButton x:Name="NoteCountToggle" Content="ノート数表示" Width="90" Margin="0,0,4,0"
                                  Checked="NoteCountToggle_Changed" Unchecked="NoteCountToggle_Changed"
                                  ToolTip="レーンラベル欄に各レーンのノート数(通常+フリーズ)を表示する"/>
                    <!-- 2026-08-02: 同じレーンに複数キーをアサインした場合等、キー表示だとラベルが
                         長くなり隣接レーンと重なって読みづらいとの要望対応。レーン名表示に切替可能にする -->
                    <ToggleButton x:Name="LaneNameLabelToggle" Content="レーン名表示" Width="90" Margin="0,0,4,0"
                                  Checked="LaneNameLabelToggle_Changed" Unchecked="LaneNameLabelToggle_Changed"
                                  ToolTip="レーンラベル欄の表示をキー割当からレーン名(内部ID)へ切り替える"/>
                    <Button x:Name="DisplaySettingsButton" Content="表示設定..." Width="80" Click="DisplaySettings_Click"/>
                    <!-- 2026-07-26要望対応(第三者提案): 譜面ビューを左右に分割し、同じ難易度タブを
                         両方に表示する(既定OFF、エディタ全体で共通の設定)。左右とも独立してスクロール可能で、
                         どちらで編集しても即座にもう一方へ反映される。キーボードモード中はTabキーで
                         アクティブ側(カーソル追従スクロールの対象)を切り替える。 -->
                    <ToggleButton x:Name="SplitViewToggle" Content="譜面ビュー分割" Width="90" Margin="8,0,0,0"
                                  Checked="SplitViewToggle_Changed" Unchecked="SplitViewToggle_Changed"
                                  ToolTip="譜面ビューを左右に分割し、同じ難易度タブを両方に表示します(独立スクロール、どちらでも編集可。キーボードモード中はTabキーでアクティブ側を切替)"/>
                </StackPanel>
                <!-- 2026-07-29要望対応: 選択範囲(時間情報レーンの範囲選択)のループ再生(DAW風、既定OFF)。
                     目視テストは常に再生開始ラインから始まり、ループ終点に到達するとループ始点へ戻って
                     再生を続ける(停止しない)。 -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="ループ再生(目視テスト):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="選択始点:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBlock x:Name="LoopStartFrameText" Text="-" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="選択終点:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBlock x:Name="LoopEndFrameText" Text="-" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ToggleButton x:Name="LoopPlaybackToggle" Content="ループ ON/OFF" Width="110"
                                  Checked="LoopPlaybackToggle_Changed" Unchecked="LoopPlaybackToggle_Changed"
                                  ToolTip="時間情報レーンで範囲選択中のみ有効。ONの間、目視テストが選択終点に到達すると選択始点へ戻って再生を続けます(再生開始ラインからのスタート自体は変わりません)"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="準備完了"/>
            </StatusBarItem>
        </StatusBar>
        <Border DockPanel.Dock="Left" Width="72" Background="#E8E8E8">
            <StackPanel Margin="4">
                <TextBlock Text="ツール" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <ToggleButton x:Name="KeyboardModeToggle" Content="キーボード&#x0a;モード" Padding="2,6"
                              ToolTip="SKB操作モード(Ctrl+,)" Click="KeyboardModeToggle_Click"/>
                <ToggleButton x:Name="ColorEditModeToggle" Content="色編集&#x0a;モード" Padding="2,6" Margin="0,6,0,0"
                              ToolTip="ncolor_data個別色編集モード" Click="ColorEditModeToggle_Click"/>
            </StackPanel>
        </Border>
        <!-- 2026-07-26: 譜面ビューと右パネルの境界線をドラッグでリサイズできるようにする要望対応。
             中央(譜面ビュー)+境界線+右パネルの3カラムGridでラップする(それ以外のDockPanel構成は不変)。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="RightPanelColumn" Width="280"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="2" Background="#E8E8E8">
            <TabControl x:Name="PropertyTabControl" PreviewMouseLeftButtonDown="PropertyTabControl_PreviewMouseLeftButtonDown">
                <TabItem Header="プロジェクト">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="曲名" Margin="0,4,0,2"/>
                            <TextBox x:Name="MusicTitleBox" TextChanged="ProjectStringField_Changed"/>
                            <TextBlock x:Name="MusicTitleWarning" Text="未入力です！" Foreground="Red" FontSize="10" Visibility="Collapsed"/>

                            <TextBlock Text="アーティスト名" Margin="0,8,0,2"/>
                            <TextBox x:Name="ArtistNameBox" TextChanged="ProjectStringField_Changed"/>

                            <TextBlock Text="アーティストURL" Margin="0,8,0,2"/>
                            <TextBox x:Name="ArtistUrlBox" TextChanged="ProjectStringField_Changed"/>

                            <TextBlock Text="BPM" Margin="0,8,0,2"/>
                            <TextBox x:Name="BpmBox" LostFocus="ProjectNumericField_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                            <Button Content="ゲージ設定..." Margin="0,8,0,0" HorizontalAlignment="Left" Click="OpenGaugeEditor_Click"/>

                            <TextBlock Text="StartNumber" Margin="0,8,0,2"/>
                            <TextBox x:Name="StartNumberBox" LostFocus="ProjectNumericField_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                            <TextBlock Text="startFrame" Margin="0,8,0,2"/>
                            <TextBox x:Name="StartFrameBox" LostFocus="ProjectNumericField_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                            <TextBlock Text="blankFrame" Margin="0,8,0,2"/>
                            <TextBox x:Name="BlankFrameBox" LostFocus="ProjectNumericField_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                            <TextBlock Text="musicURL" Margin="0,8,0,2"/>
                            <DockPanel LastChildFill="True">
                                <!-- 2026-07-26: musicURLからの楽曲取得(環境設定でON時のみ有効)。機能OFF時・読込済み時はグレーアウト -->
                                <Button x:Name="MusicUrlLoadButton" DockPanel.Dock="Right" Content="読込" Width="50" Margin="4,0,0,0"
                                        Click="MusicUrlLoadButton_Click" IsEnabled="False"/>
                                <TextBox x:Name="MusicUrlBox" TextChanged="ProjectStringField_Changed"/>
                            </DockPanel>

                            <TextBlock Text="tuning" Margin="0,8,0,2"/>
                            <TextBox x:Name="TuningBox" TextChanged="ProjectStringField_Changed"/>

                            <TextBlock Text="frzAttempt" Margin="0,8,0,2"/>
                            <TextBox x:Name="FrzAttemptBox" LostFocus="ProjectNumericField_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="現在の難易度タブ" FontWeight="Bold" Margin="0,0,0,4"/>

                            <TextBlock Text="難易度名" Margin="0,4,0,2"/>
                            <TextBox x:Name="DifficultyNameBox" TextChanged="ProjectStringField_Changed"/>
                            <TextBlock x:Name="DifficultyNameWarning" Text="未入力です！" Foreground="Red" FontSize="10" Visibility="Collapsed"/>

                            <TextBlock Text="初期speed" Margin="0,8,0,2"/>
                            <TextBox x:Name="InitialSpeedBox" LostFocus="ProjectNumericField_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                            <!-- 2026-07-26: ダンおに本体の「レベル計算ツール++」アルゴリズムを移植した参考値。
                                 タブ切替・プロパティ再読込のたびに再計算する(編集の都度リアルタイムではない)。 -->
                            <TextBlock Text="ツール値(難易度、参考値)" Margin="0,8,0,2"/>
                            <TextBlock x:Name="ToolValueText" Text="-" FontWeight="Bold"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="色設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="ColorTab0NoticeText" Text="このタブが「共通」の実体です(dos.txt出力時、無サフィックスのsetColor/frzColorになります)"
                                       FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                            <!-- 2026-08-06要望対応: setColor/frzColorを個別に「共通を使う」切替できるよう、
                                 チェックボックスをそれぞれのセクション見出しの直前に分離して配置する
                                 (以前は1つのチェックボックスで両方まとめて切り替えていた)。 -->
                            <TextBlock Text="setColor" FontWeight="Bold" Margin="0,4,0,4"/>
                            <CheckBox x:Name="SetColorCommonCheck" Content="全ての難易度で共通" Margin="0,0,0,8"
                                      Checked="SetColorCommonCheck_Changed" Unchecked="SetColorCommonCheck_Changed" Visibility="Collapsed"/>
                            <StackPanel x:Name="SetColorPanel"/>

                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="frzColor" FontWeight="Bold" Margin="0,0,0,2"/>
                            <CheckBox x:Name="FrzColorCommonCheck" Content="全ての難易度で共通" Margin="0,0,0,8"
                                      Checked="FrzColorCommonCheck_Changed" Unchecked="FrzColorCommonCheck_Changed" Visibility="Collapsed"/>
                            <StackPanel x:Name="FrzColorPanel"/>

                            <Separator Margin="0,12,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="オブジェクト">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <CheckBox x:Name="ObjectTabPinCheck" Content="このタブに固定(選択解除しても自動で切り替わらない)" Margin="0,0,0,8"/>

                            <!-- 2026-07-30要望対応: 「プロジェクト」タブに埋もれて気づきにくいとの声を受け、
                                 オブジェクト未選択時でも操作できるここにも同じボタンを配置する(プロジェクト
                                 タブ側は据え置き)。 -->
                            <Button Content="ゲージ設定..." Margin="0,0,0,10" HorizontalAlignment="Left" Click="OpenGaugeEditor_Click"/>

                            <TextBlock x:Name="ObjectNoSelectionText" Text="オブジェクトが選択されていません" FontStyle="Italic" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ObjectMultiSelectText" FontStyle="Italic" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <StackPanel x:Name="ObjectDetailPanel" Visibility="Collapsed">
                                <TextBlock x:Name="ObjectKindText" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <TextBlock x:Name="ObjectFrameLabel" Text="Frame" Margin="0,4,0,2"/>
                                <TextBox x:Name="ObjectFrameBox" LostFocus="ObjectFrame_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                                <TextBlock x:Name="ObjectEndFrameLabel" Text="Frame(終了)" Margin="0,8,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="ObjectEndFrameBox" LostFocus="ObjectEndFrame_LostFocus" Visibility="Collapsed" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                                <TextBlock x:Name="ObjectValueLabel" Text="Value" Margin="0,8,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="ObjectValueBox" LostFocus="ObjectValue_LostFocus" Visibility="Collapsed" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                                <!-- 2026-07-30要望対応: speed/boostの「始点終点オートスムージング出力」。
                                     前/次の同種マーカーとリンクすると、その間を指定した設置間隔(絶対グリッド)で
                                     自動補間した中間値をdos.txt出力・プレイテスト・プレビューへ反映する。 -->
                                <StackPanel x:Name="ObjectLinkPrevPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="ObjectLinkPrevCheck" Content="前の同種マーカーとリンクする(自動スムージング)"
                                              Checked="ObjectLinkPrev_Changed" Unchecked="ObjectLinkPrev_Changed"/>
                                    <TextBlock Text="設置間隔" Margin="16,4,0,2"/>
                                    <ComboBox x:Name="ObjectLinkPrevGridCombo" Width="100" HorizontalAlignment="Left" Margin="16,0,0,0"
                                              SelectionChanged="ObjectLinkPrevGrid_SelectionChanged">
                                        <ComboBoxItem Content="4分"/>
                                        <ComboBoxItem Content="8分"/>
                                        <ComboBoxItem Content="16分"/>
                                        <ComboBoxItem Content="32分"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="ObjectLinkNextPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="ObjectLinkNextCheck" Content="次の同種マーカーとリンクする(自動スムージング)"
                                              Checked="ObjectLinkNext_Changed" Unchecked="ObjectLinkNext_Changed"/>
                                    <TextBlock Text="設置間隔" Margin="16,4,0,2"/>
                                    <ComboBox x:Name="ObjectLinkNextGridCombo" Width="100" HorizontalAlignment="Left" Margin="16,0,0,0"
                                              SelectionChanged="ObjectLinkNextGrid_SelectionChanged">
                                        <ComboBoxItem Content="4分"/>
                                        <ComboBoxItem Content="8分"/>
                                        <ComboBoxItem Content="16分"/>
                                        <ComboBoxItem Content="32分"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 2026-07-26: 拍子(TimeSignature)の分子/分母編集(要望対応) -->
                                <TextBlock x:Name="ObjectSigNumeratorLabel" Text="拍子(分子)" Margin="0,8,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="ObjectSigNumeratorBox" LostFocus="ObjectTimeSignature_LostFocus" Visibility="Collapsed" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                <TextBlock x:Name="ObjectSigDenominatorLabel" Text="拍子(分母)" Margin="0,8,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="ObjectSigDenominatorBox" LostFocus="ObjectTimeSignature_LostFocus" Visibility="Collapsed" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                                <TextBlock x:Name="ObjectCommentLabel" Text="Comment" Margin="0,8,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="ObjectCommentBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" LostFocus="ObjectComment_LostFocus" Visibility="Collapsed"/>

                                <!-- 2026-07-23(TBD 4): 歌詞エントリ(Word)専用フィールド。段(Position)と
                                     フェードフレーム数([fadein]/[fadeout]時のみ有効)。本文はObjectCommentBoxを流用
                                     (ラベルのみ「本文」に切り替える)。種別(通常歌詞/制御)は本文が"[...]"形式かどうかで
                                     自動判定するため専用UIは設けない。 -->
                                <TextBlock x:Name="ObjectWordPositionLabel" Text="段(Position、偶数=上段/奇数=下段)" Margin="0,8,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="ObjectWordPositionBox" LostFocus="ObjectWordEntry_LostFocus" Visibility="Collapsed" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                <TextBlock x:Name="ObjectWordFadeFrameLabel" Text="フェードフレーム数(本文が[fadein]/[fadeout]の時のみ有効、既定30)" Margin="0,8,0,2" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBox x:Name="ObjectWordFadeFrameBox" LostFocus="ObjectWordEntry_LostFocus" Visibility="Collapsed" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>

                                <!-- 2026-07-26: ノート/フリーズの警告フラグ(インポート時丸め処理等でON。手動でOFFにするまで残る) -->
                                <CheckBox x:Name="ObjectWarningCheck" Content="警告(譜面ビューに警告アイコンを表示)" Margin="0,8,0,0" Visibility="Collapsed"
                                          Checked="ObjectWarning_Changed" Unchecked="ObjectWarning_Changed"/>
                                <!-- 2026-07-30要望対応: 警告とは独立した、コメント記載お知らせ用アイコン(ユーザー任意) -->
                                <CheckBox x:Name="ObjectShowCommentIconCheck" Content="コメントありお知らせアイコンを譜面ビューに表示" Margin="0,4,0,0" Visibility="Collapsed"
                                          Checked="ObjectShowCommentIcon_Changed" Unchecked="ObjectShowCommentIcon_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="その他">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <StackPanel x:Name="ExtraHeadersPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ColorEditTabItem" Header="色編集">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="編集対象" FontWeight="Bold" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="NColorSubModeNormalRadio" Content="通常色" GroupName="NColorSubMode"
                                             IsChecked="True" Checked="NColorSubMode_Changed" Margin="0,0,10,0"/>
                                <RadioButton x:Name="NColorSubModeFrzHitRadio" Content="ヒット時色" GroupName="NColorSubMode"
                                             Checked="NColorSubMode_Changed" Margin="0,0,10,0"/>
                                <RadioButton x:Name="NColorSubModeShadowRadio" Content="塗りつぶし色" GroupName="NColorSubMode"
                                             Checked="NColorSubMode_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="NColorNormalPanel">
                                <TextBlock Text="種類" Margin="0,4,0,2"/>
                                <ComboBox x:Name="NColorGradientTypeCombo" SelectionChanged="NColorField_Changed"/>

                                <TextBlock x:Name="NColorDirectionLabel" Text="方向(省略可、例: 45deg / to right)" Margin="0,8,0,2"/>
                                <TextBox x:Name="NColorDirectionBox" TextChanged="NColorField_Changed"/>

                                <TextBlock Text="色" FontWeight="Bold" Margin="0,8,0,2"/>
                                <StackPanel x:Name="NColorListPanel"/>
                                <Button x:Name="NColorAddColorButton" Content="+ 色を追加" HorizontalAlignment="Left" Margin="0,4,0,4" Click="NColorAddColorButton_Click"/>

                                <Border x:Name="NColorPreviewSwatch" Height="20" BorderBrush="Black" BorderThickness="1" Margin="0,4,0,12"/>

                                <CheckBox x:Name="NColorAllFlagCheck" Content="即時適用(全体色変化)にする" Checked="NColorAllFlagCheck_Changed" Unchecked="NColorAllFlagCheck_Changed" Margin="0,0,0,4"/>

                                <Separator Margin="0,4,0,8"/>
                                <Button x:Name="NColorBulkFillButton" Content="一括塗りつぶし(選択中のノート/フリーズ)" Click="NColorBulkFillButton_Click" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel x:Name="NColorFrzHitPanel" Visibility="Collapsed">
                                <CheckBox x:Name="NColorHitEnabledCheck" Content="端点(Hit)" Checked="NColorHitEnabled_Changed" Unchecked="NColorHitEnabled_Changed" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NColorHitColorBox" Width="96" TextChanged="NColorFrzHitField_Changed" LostFocus="NColorHitColorBox_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                    <Button x:Name="NColorHitHistoryButton" Content="履歴" Width="40" Margin="4,0,0,0" Click="NColorHitHistoryButton_Click"/>
                                </StackPanel>

                                <CheckBox x:Name="NColorHitBarEnabledCheck" Content="帯(HitBar)" Checked="NColorHitEnabled_Changed" Unchecked="NColorHitEnabled_Changed" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NColorHitBarColorBox" Width="96" TextChanged="NColorFrzHitField_Changed" LostFocus="NColorHitBarColorBox_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                    <Button x:Name="NColorHitBarHistoryButton" Content="履歴" Width="40" Margin="4,0,0,0" Click="NColorHitBarHistoryButton_Click"/>
                                </StackPanel>

                                <CheckBox x:Name="NColorHitShadowEnabledCheck" Content="塗りつぶし(HitShadow)" Checked="NColorHitEnabled_Changed" Unchecked="NColorHitEnabled_Changed" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NColorHitShadowColorBox" Width="96" TextChanged="NColorFrzHitField_Changed" LostFocus="NColorHitShadowColorBox_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                    <Button x:Name="NColorHitShadowHistoryButton" Content="履歴" Width="40" Margin="4,0,0,0" Click="NColorHitShadowHistoryButton_Click"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,8"/>
                                <Button x:Name="NColorFrzHitBulkFillButton" Content="一括塗りつぶし(選択中のフリーズ)" Click="NColorFrzHitBulkFillButton_Click" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel x:Name="NColorShadowPanel" Visibility="Collapsed">
                                <TextBlock Text="ノート(ArrowShadow)" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NColorArrowShadowColorBox" Width="96" TextChanged="NColorShadowField_Changed" LostFocus="NColorArrowShadowColorBox_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                    <Button x:Name="NColorArrowShadowHistoryButton" Content="履歴" Width="40" Margin="4,0,0,0" Click="NColorArrowShadowHistoryButton_Click"/>
                                </StackPanel>

                                <TextBlock Text="フリーズ(NormalShadow)" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NColorNormalShadowColorBox" Width="96" TextChanged="NColorShadowField_Changed" LostFocus="NColorNormalShadowColorBox_LostFocus" PreviewKeyDown="CommitOnEnter_PreviewKeyDown"/>
                                    <Button x:Name="NColorNormalShadowHistoryButton" Content="履歴" Width="40" Margin="4,0,0,0" Click="NColorNormalShadowHistoryButton_Click"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,8"/>
                                <Button x:Name="NColorShadowBulkFillButton" Content="一括塗りつぶし(選択中のノート/フリーズ)" Click="NColorShadowBulkFillButton_Click" Margin="0,0,0,4"/>
                            </StackPanel>

                            <Separator Margin="0,4,0,8"/>
                            <Button x:Name="NColorClearAllButton" Content="ncolor_dataを全て削除" Click="NColorClearAllButton_Click" Foreground="DarkRed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="MacroTabItem" Header="マクロ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <ListBox x:Name="MacroListBox" Height="220" SelectionChanged="MacroListBox_SelectionChanged"
                                     MouseDoubleClick="MacroListBox_MouseDoubleClick"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="MacroAddButton" Content="追加" Width="60" Click="MacroAddButton_Click"/>
                                <Button x:Name="MacroEditButton" Content="編集" Width="60" Margin="4,0,0,0" IsEnabled="False" Click="MacroEditButton_Click"/>
                                <Button x:Name="MacroDeleteButton" Content="削除" Width="60" Margin="4,0,0,0" IsEnabled="False" Click="MacroDeleteButton_Click"/>
                            </StackPanel>
                            <Button x:Name="MacroRunButton" Content="実行(現在の難易度タブに適用)" Margin="0,8,0,0" IsEnabled="False" Click="MacroRunButton_Click"/>

                            <!-- 2026-07-27要望対応: 範囲選択モードを撤去し、時間情報レーンのドラッグによる
                                 時間範囲選択へ統合。範囲が設定されていれば実行時に自動で範囲内のみへ適用される -->
                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="適用範囲(時間情報レーンをドラッグして指定)" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TimeRangeStatusText" Text="(未オープン)" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="※範囲が設定されている場合、実行時に範囲内のみへ自動適用されます(解除はEscapeキー)" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 2026-07-26要望対応(第三者提案): マーカー一覧からのジャンプ機能 -->
                <TabItem x:Name="MarkerTabItem" Header="マーカー">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="マーカー一覧(ダブルクリックでジャンプ)" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox x:Name="MarkerListBox" Height="320" MouseDoubleClick="MarkerListBox_MouseDoubleClick"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 2026-07-26要望対応: 同キー種タブ同士のリンク(非アクティブタブを背景に薄く表示) -->
                <TabItem x:Name="LinkTabItem" Header="リンク">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="LinkStatusText" Text="(未オープン)" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button x:Name="LinkUnlinkButton" Content="リンク解除" HorizontalAlignment="Left" Visibility="Collapsed" Click="LinkUnlinkButton_Click"/>
                            <StackPanel x:Name="LinkCandidatePanel">
                                <TextBlock Text="同じキー種のタブ一覧(リンク相手を選択)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ListBox x:Name="LinkCandidateListBox" Height="200" SelectionChanged="LinkCandidateListBox_SelectionChanged"/>
                                <Button x:Name="LinkButton" Content="リンク" Margin="0,8,0,0" IsEnabled="False" Click="LinkButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AnalysisTabItem" Header="分析" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="ITTNアナライザー(難易度分析)" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Button x:Name="AnalyzerRunButton" Content="分析を実行(現在の難易度タブ)" HorizontalAlignment="Left"
                                    Click="AnalyzerRunButton_Click" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AnalyzerResultText" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>

                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="おにスター(推定値、統一スケール)" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Button x:Name="OniStarRecalcButton" Content="算出・再算出" HorizontalAlignment="Left"
                                    Click="OniStarRecalcButton_Click" Margin="0,0,0,8"/>
                            <TextBlock x:Name="OniStarResultText" Text="？？？" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 2026-07-29要望対応: プレイ画面プレビュー(仮想スナップショット)。目視テスト中はプレビューも連動して動く -->
                <TabItem x:Name="PreviewTabItem" Header="プレビュー">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="プレイ画面プレビュー(仮想スナップショット)" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="判定は行わず、見た目の再現のみです。目視テスト中は再生位置に連動して動きます。" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>
                            <TextBlock Text="ノートの表示期限(再生開始ラインより手前のノートを消すタイミング):" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <RadioButton x:Name="PreviewExpiryPassThroughRadio" Content="ステップゾーンを通過するまで(frame &lt; 再生開始ライン、既定)"
                                         GroupName="PreviewExpiry" IsChecked="True" Checked="PreviewExpiryMode_Changed" Margin="0,0,0,2"/>
                            <RadioButton x:Name="PreviewExpiryOverlapRadio" Content="ステップゾーンに重なるまで(frame &lt;= 再生開始ライン)"
                                         GroupName="PreviewExpiry" Checked="PreviewExpiryMode_Changed" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="表示サイズ倍率:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="PreviewScaleCombo" Width="80" VerticalAlignment="Center"
                                          SelectionChanged="PreviewScaleCombo_SelectionChanged"/>
                            </StackPanel>
                            <Border x:Name="PreviewHostBorder" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#CCCCCC" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                      ToolTip="ドラッグで譜面ビュー/右パネルの幅を調整"/>
        <Grid Grid.Column="0" Background="#202020">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 2026-07-20: マルチプロジェクトタブ(仕様書TBD#10)。上段=プロジェクトタブ、下段=難易度タブの2段構成。
                 同一グループ内のみD&Dで並び替え可能(TabControl_Preview*/*_Dropは両方の行で共用のヘルパ)。 -->
            <DockPanel Grid.Row="0" Height="28">
                <Button DockPanel.Dock="Right" Content="プロジェクトを閉じる" Width="110" Click="CloseProject_Click"/>
                <!-- 2026-08-06要望対応: D&D並び替えを「離した場所のタブと入替え」ではなく「離した位置に挿入」に
                     変更するのに伴い、挿入先を示すインジケータ(縦線)をTabControlに重ねて表示する。
                     Grid内で同一セルに重ねることでオーバーレイにする(IsHitTestVisible=Falseでドラッグ判定を妨げない)。 -->
                <Grid>
                    <TabControl x:Name="ProjectTabControl"
                                SelectionChanged="ProjectTabControl_SelectionChanged"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="TabControl_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="TabControl_PreviewMouseMove"
                                PreviewDragOver="TabControl_PreviewDragOver"
                                DragLeave="TabControl_DragLeave"
                                Drop="ProjectTabControl_Drop"/>
                    <Border x:Name="ProjectTabInsertIndicator" Width="2" Background="#FF4444"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
            <DockPanel Grid.Row="1" Height="28">
                <!-- 2026-07-17: 「タブを閉じる」ができず難易度タブを削除できないとの要望対応。
                     選択中のタブを閉じる(最低1タブは残す)。 -->
                <Button DockPanel.Dock="Right" Content="タブを閉じる" Width="90" Click="CloseCurrentTab_Click"/>
                <!-- 2026-07-26: 難易度タブの複製。選択中のタブをノート・設定ごと丸ごとコピーし、
                     直後の位置へ挿入する(タブ名は「元の名前 のコピー」を自動付与) -->
                <Button DockPanel.Dock="Right" Content="タブを複製" Width="90" Click="DuplicateDifficultyTab_Click"/>
                <!-- 2026-07-26: 新規譜面(難易度タブ)追加。新規プロジェクト作成時と同じダイアログで
                     キー種・難易度名を指定し、カレントプロジェクトへタブを追加する -->
                <Button DockPanel.Dock="Right" Content="新規譜面を追加" Width="100" Click="AddDifficultyTab_Click"/>
                <Grid>
                    <TabControl x:Name="DifficultyTabControl"
                                SelectionChanged="DifficultyTabControl_SelectionChanged"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="TabControl_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="TabControl_PreviewMouseMove"
                                PreviewDragOver="TabControl_PreviewDragOver"
                                DragLeave="TabControl_DragLeave"
                                Drop="DifficultyTabControl_Drop"
                                MouseRightButtonUp="DifficultyTabControl_MouseRightButtonUp"/>
                    <Border x:Name="DifficultyTabInsertIndicator" Width="2" Background="#FF4444"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
            <!-- 2026-07-26要望対応: 譜面ビュー分割表示。既定は分割用の列(スプリッタ/ペイン2/ミニマップ2)が
                 幅0・非表示(分割OFF)で、SplitViewToggle_ChangedがApplySplitViewLayoutで列幅とVisibilityを
                 切り替える。Border(ChartPane1Border/ChartPane2Border)はキーボードモード中のアクティブペイン
                 目印(枠線)専用で、通常時はBorderThickness=0のまま見た目に影響しない。ミニマップは
                 ビュー1つにつき1つ対応させる(Minimap=左ペイン用、Minimap2=右ペイン用、2026-07-26b要望対応)。 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChartPaneColumn1" Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition x:Name="ChartSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="ChartPaneColumn2" Width="0"/>
                    <ColumnDefinition x:Name="Minimap2Column" Width="0"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ChartPane1Border" Grid.Column="0" BorderThickness="0" BorderBrush="Transparent">
                    <ScrollViewer x:Name="ChartScrollViewer"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="ChartScrollViewer_ScrollChanged"
                                  PreviewMouseDown="ChartScrollViewer_PreviewMouseDown">
                        <local:ChartCanvas x:Name="Canvas"/>
                    </ScrollViewer>
                </Border>
                <local:ChartMinimap x:Name="Minimap" Grid.Column="1"/>
                <GridSplitter x:Name="ChartSplitGridSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Background="#CCCCCC" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeWE" Visibility="Collapsed" ToolTip="ドラッグで分割の幅を調整"/>
                <Border x:Name="ChartPane2Border" Grid.Column="3" Visibility="Collapsed" BorderThickness="0" BorderBrush="Transparent">
                    <ScrollViewer x:Name="ChartScrollViewer2"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="ChartScrollViewer2_ScrollChanged"
                                  PreviewMouseDown="ChartScrollViewer2_PreviewMouseDown">
                        <local:ChartCanvas x:Name="Canvas2"/>
                    </ScrollViewer>
                </Border>
                <local:ChartMinimap x:Name="Minimap2" Grid.Column="4" Visibility="Collapsed"/>
            </Grid>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
